# Allowlist: everything is excluded unless re-included below.
# .venv, .git, .planning, data/, tests and .env are therefore excluded by construction.
*
!pyproject.toml
!src
!.streamlit
# `!.streamlit` re-includes the whole directory; keep only config.toml, never a secrets file.
.streamlit/secrets.toml
# Never ship caches or databases, even from inside allowed directories.
**/__pycache__
**/*.pyc
**/*.sqlite3*
